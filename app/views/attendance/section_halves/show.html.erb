<% content_for :title, @section.display_name %>
<h1 class="text-xl font-bold"><%= @section.display_name %></h1>
<p class="text-sm text-slate-600 mt-1"><%= @date.strftime("%d %b %Y") %></p>

<div class="mt-6 space-y-3">
  <div class="rounded-xl border bg-white p-4 shadow-sm">
    <div class="flex justify-between items-center">
      <span class="font-semibold">First half</span>
      <% if @first %>
        <span class="text-xs text-emerald-700">Taken <%= l(@first.taken_at, format: :short) rescue "" %></span>
      <% else %>
        <span class="text-xs text-slate-500">Not taken</span>
      <% end %>
    </div>
    <%= link_to (@first ? "Edit" : "Take"), (@first ? edit_attendance_session_path(@first) : new_attendance_session_path(section_id: @section.id, half: :first)), class: "mt-3 block text-center rounded-lg bg-indigo-600 text-white py-3 font-semibold" %>
  </div>

  <% if Current.school.attendance_halves_enabled? %>
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="flex justify-between items-center">
        <span class="font-semibold">Second half</span>
        <% if @second %>
          <span class="text-xs text-emerald-700">Taken <%= l(@second.taken_at, format: :short) rescue "" %></span>
        <% else %>
          <span class="text-xs text-slate-500">Not taken</span>
        <% end %>
      </div>
      <%= link_to (@second ? "Edit" : "Take"), (@second ? edit_attendance_session_path(@second) : new_attendance_session_path(section_id: @section.id, half: :second)), class: "mt-3 block text-center rounded-lg bg-indigo-600 text-white py-3 font-semibold" %>
    </div>
  <% end %>
</div>

<%= link_to "Back", root_path, class: "mt-6 inline-block text-indigo-600 underline text-sm" %>
