<% content_for :title, "Today" %>

<h1 class="text-xl font-bold text-slate-900">Today</h1>

<% if Current.user.admin? %>
  <p class="mt-2 text-slate-600 text-sm">Use the admin bar to manage the school. Teachers use the shortcuts below.</p>
  <div class="mt-4 grid gap-3">
    <%= link_to "Open admin dashboard", admin_root_path, class: "block rounded-xl bg-indigo-600 text-white text-center py-4 font-semibold" %>
  </div>
<% end %>

<% if Current.user.teacher? %>
  <h2 class="mt-6 text-sm font-semibold text-slate-500 uppercase tracking-wide">My sections</h2>
  <% if @sections_today.any? %>
    <ul class="mt-2 space-y-2">
      <% @sections_today.each do |section| %>
        <li>
          <%= link_to attendance_section_halves_path(section), class: "block rounded-xl border border-slate-200 bg-white p-4 shadow-sm active:scale-[0.99]" do %>
            <span class="font-semibold text-slate-900"><%= section.display_name %></span>
            <span class="block text-xs text-slate-500 mt-1">Take attendance</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-slate-500">No class teacher assignments yet.</p>
  <% end %>

  <h2 class="mt-8 text-sm font-semibold text-slate-500 uppercase tracking-wide">Today&apos;s bus</h2>
  <% if @buses_today.any? %>
    <ul class="mt-2 space-y-2">
      <% @buses_today.each do |bus| %>
        <li>
          <%= link_to transport_trips_path(bus_id: bus.id), data: { turbo_method: :post }, class: "block rounded-xl border border-slate-200 bg-white p-4 shadow-sm active:scale-[0.99]" do %>
            <span class="font-semibold text-slate-900"><%= bus.name %></span>
            <span class="block text-xs text-slate-500 mt-1">Open trip / stops</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-slate-500">No buses assigned to you today.</p>
  <% end %>
<% end %>
