<div id="<%= dom_id(progress) %>" class="rounded-xl border bg-white p-4 shadow-sm">
  <div class="font-semibold text-slate-900"><%= progress.bus_stop.name %></div>
  <div class="text-xs text-slate-500 mt-1">Order <%= progress.bus_stop.position %></div>
  <div class="mt-2 text-sm">
    Status: <strong class="capitalize"><%= progress.status %></strong>
    <% if progress.recorded_at %>
      <span class="text-slate-500"> — <%= l(progress.recorded_at, format: :short) %></span>
      <% if progress.recorded_by %>
        <span class="text-slate-500"> (<%= progress.recorded_by.full_name %>)</span>
      <% end %>
    <% end %>
  </div>
  <% unless trip.completed_at.present? %>
    <div class="mt-3 flex gap-2">
      <%= button_to "Reached", transport_trip_stop_progress_path(trip, progress, format: :turbo_stream), method: :patch, params: { transport_bus_stop_progress: { status: "reached" } }, class: "flex-1 rounded-lg bg-emerald-600 text-white py-2 text-sm font-semibold" %>
      <%= button_to "Skipped", transport_trip_stop_progress_path(trip, progress, format: :turbo_stream), method: :patch, params: { transport_bus_stop_progress: { status: "skipped" } }, class: "flex-1 rounded-lg bg-amber-500 text-white py-2 text-sm font-semibold" %>
    </div>
  <% end %>
</div>
