<div id="trip-complete-footer">
  <% if trip.completed_at.present? %>
    <p class="mt-4 text-sm text-emerald-700 font-semibold">Completed at <%= l(trip.completed_at, format: :short) %></p>
  <% elsif trip.all_stops_resolved? %>
    <%= button_to "Complete trip", complete_transport_trip_path(trip), method: :post, class: "mt-4 w-full rounded-xl bg-emerald-600 text-white py-3 font-semibold" %>
  <% end %>
</div>
