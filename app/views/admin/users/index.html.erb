<% content_for :title, "Users" %>
<div class="flex justify-between items-center">
  <h1 class="text-xl font-bold">Users</h1>
  <%= link_to "New", new_admin_user_path, class: "text-indigo-600 underline text-sm" %>
</div>
<ul class="mt-4 space-y-2 text-sm">
  <% @users.each do |u| %>
    <li class="flex justify-between border rounded-lg p-3 bg-white">
      <span><%= u.full_name %> — <%= u.email_address %> (<%= u.role %>) <%= u.active? ? "" : "[inactive]" %></span>
      <%= link_to "Edit", edit_admin_user_path(u), class: "text-indigo-600 underline" %>
    </li>
  <% end %>
</ul>
