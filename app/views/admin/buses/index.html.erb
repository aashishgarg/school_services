<% content_for :title, "Buses" %>
<div class="flex justify-between items-center">
  <h1 class="text-xl font-bold">Buses</h1>
  <%= link_to "New", new_admin_bus_path, class: "text-indigo-600 underline text-sm" %>
</div>
<ul class="mt-4 space-y-2 text-sm">
  <% @buses.each do |b| %>
    <li class="flex justify-between border rounded-lg p-3 bg-white">
      <span><%= b.name %> — <%= b.plate_no %></span>
      <span>
        <%= link_to "Stops", admin_bus_bus_stops_path(b), class: "text-indigo-600 underline mr-2" %>
        <%= link_to "Edit", edit_admin_bus_path(b), class: "text-indigo-600 underline" %>
      </span>
    </li>
  <% end %>
</ul>
