<%= form_with model: [:admin, @year], class: "space-y-3" do |f| %>
  <%= f.label :name %>
  <%= f.text_field :name, class: "w-full border rounded px-2 py-2" %>
  <%= f.label :starts_on %>
  <%= f.date_field :starts_on, class: "w-full border rounded px-2 py-2" %>
  <%= f.label :ends_on %>
  <%= f.date_field :ends_on, class: "w-full border rounded px-2 py-2" %>
  <label class="flex gap-2 items-center text-sm">
    <%= f.check_box :current %> Current year
  </label>
  <%= f.submit class: "rounded-xl bg-indigo-600 text-white px-6 py-2 font-semibold" %>
<% end %>
