<% content_for :title, "Sections" %>
<div class="flex justify-between items-center">
  <h1 class="text-xl font-bold">Sections</h1>
  <%= link_to "New", new_admin_section_path, class: "text-indigo-600 underline text-sm" %>
</div>
<ul class="mt-4 space-y-2 text-sm">
  <% @sections.each do |s| %>
    <li class="flex justify-between border rounded-lg p-3 bg-white">
      <span><%= s.school_class.name %> <%= s.name %> — <%= s.academic_year.name %></span>
      <%= link_to "Edit", edit_admin_section_path(s), class: "text-indigo-600 underline" %>
    </li>
  <% end %>
</ul>
